{
  "expo": {
    "name": "EliteFutBot",
    "slug": "elite-fut-bot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo_new.png",
    "scheme": "elitefutbot",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo_new.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.elitefutbot.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/logo_new.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_new.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
